# rosu-web environment variables — names only. Real values go in Vercel
# (Project → Settings → Environment Variables). Copy to .env.local for local dev.

# Database (Neon Postgres — pooled connection string)
DATABASE_URL=

# Google Drive (reuse the desktop app's OAuth client; mint a refresh token once
# by consenting as rosu.app@gmail.com — see scripts/mint-drive-token.mjs)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER=Rosu Reports

# Cloudflare Turnstile (web-form captcha)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Desktop shared friction token (must equal rosu/report.py REPORT_TOKEN)
REPORT_APP_TOKEN=

# Admin viewer
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Security
IP_HASH_SALT=
CRON_SECRET=

# Auto-archive: when this many unarchived reports pile up, archive to Drive
# immediately (the daily cron remains the backstop). Optional — defaults to 25;
# set 0 to disable.
AUTO_ARCHIVE_THRESHOLD=25

# ── v1.3.0 (all optional) ─────────────────────────────────────────────────────
# Secret admin path: with e.g. ADMIN_PATH=ops-2f9c1d7e4b the panel lives at
# /ops-2f9c1d7e4b and /admin answers 404. 12-64 chars of A-Z a-z 0-9 _ -.
ADMIN_PATH=
# Two-factor sign-in (base32). Generate with: node scripts/totp-setup.mjs
ADMIN_TOTP_SECRET=

# Opt-in confirmation e-mail after a report (Resend free tier). Both must be
# set to enable the checkbox. Until a domain is verified in Resend, its test
# sender (onboarding@resend.dev) only delivers to the Resend account's own address.
RESEND_API_KEY=
ACK_EMAIL_FROM=

# Dead-man's switch for the nightly job (healthchecks.io ping URL, https).
HEALTHCHECKS_PING_URL=

# Raises the GitHub API limit for /api/latest-version (fine-grained token, no
# scopes needed for public repos). Optional — responses are CDN-cached anyway.
GITHUB_TOKEN=
